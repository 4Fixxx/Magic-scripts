#start  ~By 4Fix / github.com/4Fixxx/Magic  /  github.com/4Fixxx/Magic-scripts
setname m1, <ADDR>
setname m2, <DATA>
add $ADDR$, 904
add $DATA$, 905
output <16> $ADDR$, 32; delay; output <16> $DATA$, 2; delay
output <16> $ADDR$, 64; delay; output <16> $DATA$, 20; delay
output <16> $ADDR$, 96; delay; output <16> $DATA$, 240; delay
output <16> $ADDR$, 128; delay; output <16> $DATA$, 6; delay
output <16> $ADDR$, 35; delay; output <16> $DATA$, 1; delay
output <16> $ADDR$, 67; delay; output <16> $DATA$, 0; delay
output <16> $ADDR$, 99; delay; output <16> $DATA$, 240; delay
output <16> $ADDR$, 131; delay; output <16> $DATA$, 6; delay
print "                 <13>MAGIC <14>MUSIC <11>BOX"
print "         <9>plays music based on what random drops"
#song
random a
compare a, 0
if d is -1
    mul a, -1
        else
            nop
div a, 10
if d is 0
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 0; delay
    output <16> $ADDR$, 160; delay; output <16> $DATA$, 89; delay
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 49; delay
    print "                <4>C"
        else
            nop
if d is 1
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 0; delay
    output <16> $ADDR$, 160; delay; output <16> $DATA$, 131; delay
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 49; delay
    print "                    <6>D"
        else
            nop
if d is 2
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 0; delay
    output <16> $ADDR$, 160; delay; output <16> $DATA$, 179; delay
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 49; delay
    print "                        <2>E"
        else
            nop
if d is 3
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 0; delay
    output <16> $ADDR$, 160; delay; output <16> $DATA$, 5; delay
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 50; delay
    print "                            <3>G"
        else
            nop
if d is 4
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 0; delay
    output <16> $ADDR$, 160; delay; output <16> $DATA$, 68; delay
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 50; delay
    print "                                <5>A"
        else
            nop
if d is 5
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 0; delay
    output <16> $ADDR$, 160; delay; output <16> $DATA$, 89; delay
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 53; delay
    print "                                    <12>C"
        else
            nop
if d is 6
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 0; delay
    output <16> $ADDR$, 160; delay; output <16> $DATA$, 131; delay
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 53; delay
    print "                                        <14>D"
        else
            nop
if d is 7
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 0; delay
    output <16> $ADDR$, 160; delay; output <16> $DATA$, 179; delay
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 53; delay
    print "                                            <10>E"
        else
            nop
if d is 8
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 0; delay
    output <16> $ADDR$, 160; delay; output <16> $DATA$, 5; delay
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 54; delay
    print "                                                <11>G"
        else
            nop
if d is 9
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 0; delay
    output <16> $ADDR$, 160; delay; output <16> $DATA$, 68; delay
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 54; delay
    print "                                                    <13>A"
        else
            nop
random b
compare b, 0
if d is -1
    mul b, -1
        else
            nop
div b, 3
add c, 70000
if d is 0
    add c, 70000
        else
            nop
[
nop
]
jump #song
#end

!<delay>
    wait 1
