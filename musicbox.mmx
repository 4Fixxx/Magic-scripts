#start
setname m1, <ADDR>
setname m2, <DATA>
add $ADDR$, 904
add $DATA$, 905
output $ADDR$, 32; wait; output $DATA$, 2; wait
output $ADDR$, 64; wait; output $DATA$, 20; wait
output $ADDR$, 96; wait; output $DATA$, 240; wait
output $ADDR$, 128; wait; output $DATA$, 6; wait
output $ADDR$, 35; wait; output $DATA$, 1; wait
output $ADDR$, 67; wait; output $DATA$, 0; wait
output $ADDR$, 99; wait; output $DATA$, 240; wait
output $ADDR$, 131; wait; output $DATA$, 6; wait
print "                 MAGIC MUSIC BOX"
print "         plays music based on what random drops"
#song
random a
compare a, 0
if d is -1
    mul a, -1
        else
            nop
div a, 10
