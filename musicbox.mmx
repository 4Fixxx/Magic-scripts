    output <16> $ADDR$, 176; delay; output <16> $DATA$, 54; delay
    print "                                                    A"
        else
            nop
random b
compare b, 0
if d is -1
    mul b, -1
        else
            nop
div b, 3
add c, 70000
if d is 0
    add c, 70000
        else
            nop
[
nop
]
jump #song
#end

!<delay>
    add c, 20
    [
    nop
