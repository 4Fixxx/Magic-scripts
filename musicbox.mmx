    output <16> $ADDR$, 176; delay; output <16> $DATA$, 50; delay
    print "                                A"
        else
            nop
if d is 5
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 0; delay
    output <16> $ADDR$, 160; delay; output <16> $DATA$, 89; delay
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 53; delay
    print "                                    C"
        else
            nop
if d is 6
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 0; delay
    output <16> $ADDR$, 160; delay; output <16> $DATA$, 131; delay
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 53; delay
    print "                                        D"
        else
            nop
if d is 7
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 0; delay
    output <16> $ADDR$, 160; delay; output <16> $DATA$, 179; delay
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 53; delay
    print "                                            E"
        else
            nop
if d is 8
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 0; delay
    output <16> $ADDR$, 160; delay; output <16> $DATA$, 5; delay
    output <16> $ADDR$, 176; delay; output <16> $DATA$, 54; delay
    print "                                                G"
