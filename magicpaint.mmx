@function
    on input <left>
        if $X$ not 0
            sub $X$, 1
        update

@function
    on input <right>
        if $X$ not 19
            add $X$, 1
        update

@function
    on input <up>
        if $Y$ not 0
            sub $Y$, 1
        update

@function
    on input <down>
        if $Y$ not 9
            add $Y$, 1
        update

@function
    on input <space>
        mul $PEN$, -1; add $PEN$, 1
        update

@function
    on input <0>
        copy 32, $COLOR$

@function
    on input <1>
        copy 4128, $COLOR$

@function
    on input <2>
        copy 8224, $COLOR$

@function
    on input <3>
