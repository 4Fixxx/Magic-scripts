#start
setname m1, <ADDR>
setname m2, <DATA>
add $ADDR$, 904
add $DATA$, 905
output $ADDR$, 32; wait; output $DATA$, 1; wait
output $ADDR$, 64; wait; output $DATA$, 16; wait
output $ADDR$, 96; wait; output $DATA$, 240; wait
output $ADDR$, 128; wait; output $DATA$, 119; wait
output $ADDR$, 35; wait; output $DATA$, 1; wait
output $ADDR$, 67; wait; output $DATA$, 0; wait
output $ADDR$, 99; wait; output $DATA$, 240; wait
output $ADDR$, 131; wait; output $DATA$, 119; wait
print "          keys: a s d f g h j k w e t y u, X turns off all sound. Made by 4Fix"
#end

